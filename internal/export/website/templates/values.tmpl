{{/* value renders one *model.Value by its field kind. Entity pages live in
     entities/, so links to other entities are relative to that folder. */}}
{{- define "value" -}}
{{- $k := kind . -}}
{{- if not .Present -}}
<span class="absent">—</span>
{{- else if .Invalid -}}
<span class="invalid-value">{{.Raw}}</span> <span class="invalid">{{.Problem}}</span>
{{- else if eq $k "number" -}}
{{number .Num}}
{{- else if eq $k "boolean" -}}
{{if .Bool}}true{{else}}false{{end}}
{{- else if eq $k "text" -}}
<div class="text">{{markdown .Str}}</div>
{{- else if eq $k "link" -}}
{{range $i, $id := .IDs}}{{if $i}}, {{end}}{{template "ref" (ref $id (index $.Targets $i))}}{{end}}
{{- else if eq $k "list" -}}
{{template "list" .}}
{{- else -}}
{{.Str}}
{{- end -}}
{{- end -}}

{{/* ref renders one link target: a hyperlink, or the bare ID marked
     unresolved when no entity has it. */}}
{{- define "ref" -}}
{{- if .Entity -}}
<a class="id" href="{{.ID}}.html"{{with .Entity.Title}} title="{{.}}"{{end}}>{{.ID}}</a>
{{- else -}}
<span class="id unresolved-id">{{.ID}}</span> <span class="unresolved">unresolved</span>
{{- end -}}
{{- end -}}

{{/* list renders a list field's items as a bulleted list, or its rows as a
     table, one column per sub-field. */}}
{{- define "list" -}}
{{- if .Field.Elem -}}
{{- if .Items -}}
<ul class="items">
{{- range .Items}}
<li>{{template "value" .}}</li>
{{- end}}
</ul>
{{- else -}}
<span class="absent">no items</span>
{{- end -}}
{{- else if .Rows -}}
<table class="list">
<thead><tr>{{range .Field.Fields}}<th>{{humanize .Name}}</th>{{end}}</tr></thead>
<tbody>
{{- range .Rows}}
<tr>{{range .}}<td>{{template "value" .}}</td>{{end}}</tr>
{{- end}}
</tbody>
</table>
{{- else -}}
<span class="absent">no rows</span>
{{- end -}}
{{- end -}}
