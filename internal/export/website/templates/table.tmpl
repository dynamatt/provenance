{{/* table is the built-in page of a CSV file whose rows are entities
     (DES-0053): the file, then its rows. The file's commits are the
     page's revision history, in the layout. */}}
{{define "table"}}
<article class="entity table-page" id="{{.Type}}">
<p class="entity-type">Table</p>
<h1>{{.Type}}</h1>
<table class="fields">
<tbody>
<tr><th>File</th><td><code>{{.File.Path}}</code></td></tr>
<tr><th>Rows</th><td>{{.Rows}}</td></tr>
</tbody>
</table>
{{.RowsHTML}}</article>
{{end}}

{{/* table-list lists the rows of a file whose rows have pages. */}}
{{define "table-list"}}
{{- if .}}
<table class="entity-list">
<thead><tr><th>ID</th><th>Title</th></tr></thead>
<tbody>
{{- range .}}
<tr id="{{.ID}}"><td class="id">{{ref .ID .}}</td><td>{{.Title}}</td></tr>
{{- end}}
</tbody>
</table>
{{else}}
<p class="placeholder">The file has no rows.</p>
{{end -}}
{{end}}

{{/* table-head opens the table of a file whose rows have no pages: one
     column per field and incoming facet. */}}
{{define "table-head"}}
<table class="list table-rows">
<thead><tr><th>ID</th>{{range .}}<th>{{humanize .}}</th>{{end}}</tr></thead>
<tbody>
{{end}}

{{/* table-row is one row of that table, at an anchor of its ID. */}}
{{define "table-row" -}}
<tr id="{{.ID}}"><td class="id">{{.ID}}</td>
{{- range .Fields}}<td>{{template "value" .}}</td>{{end}}
{{- range .Incoming}}<td>{{range $i, $e := .From}}{{if $i}}, {{end}}{{ref $e.ID $e}}{{else}}<span class="absent">—</span>{{end}}</td>{{end -}}
</tr>
{{end}}
