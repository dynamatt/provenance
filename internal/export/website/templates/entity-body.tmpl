{{/* entity is the built-in fallback rendering of one entity (an entityPage):
     used for its own page and when it is embedded with ![[ID]].

     It declares two blocks, empty here, that a type's template holding
     only {{define}}s fills (DES-0031): "before-body" and "after-body",
     around the body. Their dot is the entity as project templates see it
     (.Data), not this page's view of it. */}}
{{define "entity"}}
<article class="entity" id="{{.ID}}" data-type="{{.Type}}">
<p class="entity-type">{{.Type}}</p>
<h1><span class="id">{{.ID}}</span> {{.Title}}</h1>
{{- if or .Fields .Incoming}}
<table class="fields">
<tbody>
{{- range .Fields}}
<tr><th>{{label .Field}}</th><td>{{template "value" .}}</td></tr>
{{- end}}
{{- range .Incoming}}
<tr class="incoming"><th>{{.Facet.Label}}</th><td>
{{- range $i, $e := .From}}{{if $i}}, {{end}}{{ref $e.ID $e}}{{else}}<span class="absent">—</span>{{end -}}
</td></tr>
{{- end}}
</tbody>
</table>
{{- end}}
{{- with .RowFile}}
<p class="table-row">Row {{.Line}} of <code>{{.Path}}</code>.</p>
{{- end}}
{{- block "before-body" .Data}}{{end}}
{{- with .BodyField}}
<h2>{{label .Field}}</h2>
<div class="body">
{{markdown .Str}}</div>
{{- end}}
{{- with .Body}}
<div class="body">
{{markdown .}}</div>
{{- end}}
{{- block "after-body" .Data}}{{end}}
</article>
{{end}}
