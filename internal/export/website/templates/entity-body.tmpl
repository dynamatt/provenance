{{/* entity is the built-in fallback rendering of one entity (an entityPage):
     used for its own page and when it is embedded with ![[ID]]. */}}
{{define "entity"}}
<article class="entity" id="{{.ID}}">
<p class="entity-type">{{.Type}}</p>
<h1><span class="id">{{.ID}}</span> {{.Title}}</h1>
{{- if or .Fields .Incoming}}
<table class="fields">
<tbody>
{{- range .Fields}}
<tr><th>{{humanize .Field.Name}}</th><td>{{template "value" .}}</td></tr>
{{- end}}
{{- range .Incoming}}
<tr class="incoming"><th>{{humanize .Facet.Name}}</th><td>
{{- range $i, $e := .From}}{{if $i}}, {{end}}{{ref $e.ID $e}}{{else}}<span class="absent">—</span>{{end -}}
</td></tr>
{{- end}}
</tbody>
</table>
{{- end}}
{{- with .Table}}
<p class="table-row">Row {{$.Line}} of {{if $.TableHref}}<a href="{{$.TableHref}}">{{.File}}</a>{{else}}{{.File}}{{end}}
{{- if .System}}, a dump of {{.System}}{{with .Exported}} exported {{.}}{{end}}{{else}}, a table kept in the repository{{end}}
{{- with .Commit}}, committed in <code>{{short .}}</code> on {{$.Table.Date}}{{end}}.</p>
{{- end}}
{{- with .BodyField}}
<h2>{{humanize .Field.Name}}</h2>
<div class="body">
{{markdown .Str}}</div>
{{- end}}
{{- with .Body}}
<div class="body">
{{markdown .}}</div>
{{- end}}
</article>
{{end}}
