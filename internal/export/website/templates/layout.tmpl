<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="{{.Root}}style.css">
</head>
<body>
<header class="site-header">
<a class="site-name" href="{{.Root}}index.html">{{.Component.Name}}</a>
<span class="site-code">{{.Component.Code}}</span>
</header>
<main>
{{template "content" .}}
</main>
{{- with .Revisions}}
<details class="revisions">
<summary>Revision history</summary>
<table>
<thead><tr><th>Commit</th><th>Date</th><th>Author</th><th>Change</th></tr></thead>
<tbody>
{{- range .}}
<tr><td><code>{{.Short}}</code>{{range .Tags}} <span class="tag">{{.}}</span>{{end}}</td><td>{{.Date}}</td><td>{{.Author}}</td><td>{{.Subject}}</td></tr>
{{- end}}
</tbody>
</table>
</details>
{{- end}}
<footer class="site-footer">Generated by Provenance
{{- with .GitSHA}} from commit <code>{{short .}}</code>{{end}}
{{- with .ContentHash}} · content hash <code>{{.}}</code>{{end}}
{{- with .LastChangedSHA}} · this page last changed in <code>{{short .}}</code>{{end}}</footer>
</body>
</html>
