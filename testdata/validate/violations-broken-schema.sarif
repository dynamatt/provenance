{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "provenance",
          "version": "dev",
          "informationUri": "https://github.com/dynamatt/provenance",
          "rules": [
            {
              "id": "content/caption",
              "shortDescription": {
                "text": "A caption that cannot be placed or referred to"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/duplicate-id",
              "shortDescription": {
                "text": "Two files with one ID"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/embed",
              "shortDescription": {
                "text": "An embed inside running text"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/embed-cycle",
              "shortDescription": {
                "text": "Entities that embed each other"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/frontmatter",
              "shortDescription": {
                "text": "Frontmatter that cannot be read"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/image",
              "shortDescription": {
                "text": "An image the website cannot publish"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/query",
              "shortDescription": {
                "text": "A query block that cannot run"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/template",
              "shortDescription": {
                "text": "A template that cannot render"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/template-name",
              "shortDescription": {
                "text": "A template named for nothing"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "content/unknown-override",
              "shortDescription": {
                "text": "An underscore template that overrides nothing"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "content/unrendered-block",
              "shortDescription": {
                "text": "A block this version publishes only as source"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "content/unused-template",
              "shortDescription": {
                "text": "A named template no query chooses"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "links/target-type",
              "shortDescription": {
                "text": "A link to an entity of the wrong type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "links/unknown-field",
              "shortDescription": {
                "text": "A field reference to a field the target does not have"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "links/unresolved",
              "shortDescription": {
                "text": "A link to no entity"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules/file",
              "shortDescription": {
                "text": "A rule file that is not a YAML mapping"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules/message",
              "shortDescription": {
                "text": "A rule without a message"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules/name",
              "shortDescription": {
                "text": "A rule file not named for a kebab-case ID"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules/query",
              "shortDescription": {
                "text": "A rule whose query does not fit the schema"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules/severity",
              "shortDescription": {
                "text": "A rule severity other than error or warning"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules/unknown-key",
              "shortDescription": {
                "text": "A key a rule file does not have"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/calculated-set",
              "shortDescription": {
                "text": "A calculated field written in the file"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/enum-value",
              "shortDescription": {
                "text": "A value not in its enum"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/file",
              "shortDescription": {
                "text": "A schema file that cannot be loaded"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/formula",
              "shortDescription": {
                "text": "A calculated field whose formula cannot run"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/id-format",
              "shortDescription": {
                "text": "An ID that is not the type's form"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/invalid-value",
              "shortDescription": {
                "text": "A value not of its field's type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/link-target",
              "shortDescription": {
                "text": "A link field targeting an undeclared type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/list-row",
              "shortDescription": {
                "text": "A list row with a key its list does not have"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/required",
              "shortDescription": {
                "text": "A required field not set"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/unknown-field",
              "shortDescription": {
                "text": "A frontmatter key the type does not have"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/unknown-key",
              "shortDescription": {
                "text": "A key the schema language does not have"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/unknown-type",
              "shortDescription": {
                "text": "An entity of an undeclared type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/unused-enum",
              "shortDescription": {
                "text": "An enum no field uses"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "schema/unused-record",
              "shortDescription": {
                "text": "A record no list uses"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "schema/unused-type",
              "shortDescription": {
                "text": "A type with no entities and no links"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "The repository root."
          }
        }
      },
      "results": [
        {
          "ruleId": "schema/file",
          "ruleIndex": 23,
          "level": "error",
          "message": {
            "text": "did not find expected ',' or ']'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "schema/Broken.yaml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        },
        {
          "ruleId": "schema/file",
          "ruleIndex": 23,
          "level": "error",
          "message": {
            "text": "field \"status\": unknown type \"AprovalStatus\" (expected string, text, number, date, boolean, link, list, calculated)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "schema/UnknownType.yaml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
