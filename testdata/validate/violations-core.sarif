                "text": "no widget is WID-9999"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules-file-violation",
              "shortDescription": {
                "text": "rules-file-violation"
              }
            },
            {
              "id": "rules-message-violation",
              "shortDescription": {
                "text": "rules-message-violation"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules-query-violation",
