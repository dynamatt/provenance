                "text": "names a field Widget lacks"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "rules-severity-violation",
              "shortDescription": {
                "text": "not error or warning"
              }
            },
            {
              "id": "rules-unknown-key-violation",
              "shortDescription": {
                "text": "has an id"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
