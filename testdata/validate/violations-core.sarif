              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/invalid-value",
              "shortDescription": {
                "text": "A value not of its field's type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/link-target",
              "shortDescription": {
                "text": "A link field targeting an undeclared type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/list-row",
              "shortDescription": {
                "text": "A list row with a key its list does not have"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/required",
              "shortDescription": {
                "text": "A required field not set"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/unknown-field",
              "shortDescription": {
                "text": "A frontmatter key the type does not have"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/unknown-key",
              "shortDescription": {
                "text": "A key the schema language does not have"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/unknown-type",
              "shortDescription": {
                "text": "An entity of an undeclared type"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "schema/unused-enum",
              "shortDescription": {
                "text": "An enum no field uses"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "schema/unused-record",
              "shortDescription": {
                "text": "A record no list uses"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "schema/unused-type",
